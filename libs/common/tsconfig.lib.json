{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/libs/common",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "inlineSourceMap": true,
    "incremental": true,
    "tsBuildInfoFile": "../../dist/libs/common/.tsbuildinfo"
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/*spec.ts",
    "**/*test.ts"
  ]
}