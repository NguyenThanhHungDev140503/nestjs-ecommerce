NODE_ENV=development
DB_HOST=postgres-db
DB_NAME=ecommerce
DB_USER=postgres
DB_PASSWORD=postgres
RABBITMQ_URL=amqp://host.docker.internal:5672
RABBITMQ_ORDER_QUEUE=order-queue
RABBITMQ_CUSTOMER_INFO_QUEUE=customer-info-queue
RABBITMQ_INVENTORY_INFO_QUEUE=inventory-info-queue

# Notification Service
RABBITMQ_NOTIFICATION_QUEUE=notification-queue
RABBITMQ_NOTIFICATION_EXCHANGE=notification-exchange

# Novu Configuration (Self-hosted)
NOVU_API_KEY=your-novu-api-key
NOVU_APP_ID=your-novu-app-id
NOVU_API_URL=http://localhost:3004
NOVU_BACKEND_URL=http://localhost:3004
NOVU_JWT_SECRET=your-novu-jwt-secret-change-this
NOVU_STORE_ENCRYPTION_KEY=your-encryption-key-32-characters

# Notification Channels (config-driven)
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_SMS_ENABLED=false
NOTIFICATION_PUSH_ENABLED=false
NOTIFICATION_INAPP_ENABLED=true

# Notification Retry Settings
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_BASE_DELAY=1000
NOTIFICATION_RETRY_MAX_DELAY=30000

# Notification Rate Limiting
NOTIFICATION_RATE_LIMIT_TTL=60
NOTIFICATION_RATE_LIMIT=100