digraph CreateOrder {
    rankdir=LR;
    node [shape=box, style=filled, color=lightblue, fontname="Arial"];
    edge [fontname="Arial", fontsize=10];

    Client [shape=ellipse, color=green, label="Client\n(HTTP Request)"];

    // =====================================
    // API GATEWAY - CHI TIẾT CÁC HÀM
    // =====================================
    subgraph cluster_APIGateway {
        label = "API Gateway (apps/api-gateway)";
        style=filled;
        color=lightcyan;
        fontname="Arial Bold";

        // Controller Layer
        subgraph cluster_Controller {
            label = "OrderManagementController\n(order-management.controller.ts)";
            style=dashed;
            color=blue;

            Controller_Post [label="@Post()\ncreateOrder()\nLine 70-88", shape=box, color=lightyellow];
            Controller_Log [label="console.log()\n'Received Order Creation request'", shape=note, color=lightgray];
            Controller_TryCatch [label="try-catch block\nError Handling", shape=diamond, color=lightyellow];
            Controller_Response_Success [label="Return Response\n{ status: 'success',\nmessage: 'Order created',\ndata: null }", shape=box, color=lightgreen];
            Controller_Response_Error [label="throw HttpException\n{ status: 'error',\nmessage: errorMessage }\nHTTP 500", shape=box, color=lightcoral];
        }

        // Service Layer
        subgraph cluster_Service {
            label = "OrderManagementService\n(order-management.service.ts)";
            style=dashed;
            color=purple;

            Service_CreateOrder [label="createOrder()\nLine 22-29\n@Body() createOrder: CreateOrderDto\n@Headers() authToken: string", shape=box, color=lightyellow];
            Service_DecodeToken [label="Mock Token Decode\ndecodedToken = \n{ customerId: 'CUST01' }", shape=note, color=lightgray];
            Service_BuildPayload [label="Build Message Payload\nmessagePayload = {\n  customerId: decodedToken.customerId,\n  ...createOrder\n}", shape=box, color=lightyellow];
            Service_Emit [label="ClientProxy.emit()\n{ cmd: EVENT_PATTERNS.CREATE_ORDER }\nmessagePayload", shape=box, color=orange];
            Service_Return [label="return { message:\n'Order created successfully' }", shape=box, color=lightgreen];
        }

        // Dependencies
        subgraph cluster_Dependencies {
            label = "Dependencies & Injections";
            style=dashed;
            color=gray;

            ClientProxy_Inject [label="@Inject(ORDER_MANAGEMENT_SERVICE)\nprivate orderManagementClient:\nClientProxy", shape=component, color=lightblue];
            CreateOrderDto [label="CreateOrderDto\n(libs/common/dto)\n- customerId?: string\n- items: OrderItemDto[]\n- shippingAddress?: string\n- trackingInfo?: string", shape=note, color=lightyellow];
        }
    }

    RabbitMQ_Event [shape=diamond, color=orange, label="RabbitMQ\nQueue: order-queue\nEvent: order.create"];

    // =====================================
    // ORDER MANAGEMENT SERVICE
    // =====================================
    subgraph cluster_OrderService {
        label = "Order Management Service (apps/order-management)";
        style=filled;
        color=lightpink;

        Order_Service_Controller [label="OrderManagementController\n@EventPattern({ cmd: 'order.create' })\nhandleCreateOrder(order)"];
        Order_Service_Service [label="OrderManagementService\nhandleCreateOrder()"];

        Customer_Proxy [label="ClientProxy\n(Customer Service)"];
        Inventory_Proxy [label="ClientProxy\n(Inventory Service)"];

        DB_Transaction [shape=note, color=yellow, label="DB Transaction\n(Start)"];
        DB_Save_Order [shape=cylinder, color=grey, label="PostgreSQL\n(Save Order)"];
        DB_Save_Items [shape=cylinder, color=grey, label="PostgreSQL\n(Save Line Items)"];
        DB_Commit [shape=note, color=yellow, label="DB Transaction\n(Commit)"];
    }

    RabbitMQ_RPC_Cust [shape=diamond, color=orange, label="RabbitMQ\nRPC: customer.get"];
    RabbitMQ_RPC_Inv [shape=diamond, color=orange, label="RabbitMQ\nRPC: inventory.get"];

    // =====================================
    // LUỒNG GỌI CHI TIẾT - API GATEWAY
    // =====================================

    // Client -> Controller
    Client -> Controller_Post [label="POST /orders\nBody: CreateOrderDto"];

    // Controller internal flow
    Controller_Post -> Controller_Log [label="1. Log request"];
    Controller_Log -> Controller_TryCatch [label="2. Enter try block"];
    Controller_TryCatch -> Service_CreateOrder [label="3. Call service"];

    // Service internal flow
    Service_CreateOrder -> Service_DecodeToken [label="4. Decode JWT\n(mock)"];
    Service_DecodeToken -> Service_BuildPayload [label="5. Build payload"];
    Service_BuildPayload -> ClientProxy_Inject [label="6. Use injected\nClientProxy"];
    ClientProxy_Inject -> Service_Emit [label="7. Emit event"];
    Service_Emit -> RabbitMQ_Event [label="8. Async emit\n(Fire & Forget)"];
    Service_Emit -> Service_Return [label="9. Immediate return"];
    Service_Return -> Controller_TryCatch [label="10. Return to controller"];

    // Controller response
    Controller_TryCatch -> Controller_Response_Success [label="11a. Success path"];
    Controller_TryCatch -> Controller_Response_Error [label="11b. Error path", style=dashed, color=red];
    Controller_Response_Success -> Client [label="HTTP 200 OK\n{ status: 'success' }"];
    Controller_Response_Error -> Client [label="HTTP 500 Error", style=dashed, color=red];

    // DTO Reference
    Controller_Post -> CreateOrderDto [label="Validate DTO", style=dotted];

    // =====================================
    // LUỒNG GỌI - ORDER SERVICE (Async)
    // =====================================
    RabbitMQ_Event -> Order_Service_Controller [label="Consume Event\n(Async)"];
    Order_Service_Controller -> Order_Service_Service [label="handleCreateOrder()"];

    Order_Service_Service -> Customer_Proxy [label="Get Customer Info"];
    Customer_Proxy -> RabbitMQ_RPC_Cust [label="Send Request"];
    RabbitMQ_RPC_Cust -> Customer_Proxy [label="Return Details"];

    Order_Service_Service -> Inventory_Proxy [label="Get Inventory Info"];
    Inventory_Proxy -> RabbitMQ_RPC_Inv [label="Send Request"];
    RabbitMQ_RPC_Inv -> Inventory_Proxy [label="Return Details"];

    Order_Service_Service -> DB_Transaction [label="Start"];
    DB_Transaction -> DB_Save_Order [label="Save Order"];
    DB_Save_Order -> DB_Save_Items [label="Save Items"];
    DB_Save_Items -> DB_Commit [label="Commit"];
    DB_Commit -> Order_Service_Service [label="Success"];

    // =====================================
    // LEGEND
    // =====================================
    subgraph cluster_Legend {
        label = "Legend";
        style=filled;
        color=white;

        Legend_Sync [label="Sync Call", shape=box, color=lightblue];
        Legend_Async [label="Async Event", shape=diamond, color=orange];
        Legend_DB [label="Database", shape=cylinder, color=grey];
        Legend_Note [label="Note/Comment", shape=note, color=lightgray];
    }
}
