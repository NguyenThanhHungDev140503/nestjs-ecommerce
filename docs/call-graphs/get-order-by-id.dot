digraph GetOrderById {
    rankdir=LR;
    node [shape=box, style=filled, color=lightblue];

    Client [shape=ellipse, color=green, label="Client"];
    API_Gateway_Controller [label="OrderManagementController\n(API Gateway)\n@Get(':id')"];
    API_Gateway_Service [label="OrderManagementService\n(API Gateway)\ngetOrderById()"];
    RabbitMQ [shape=diamond, color=orange, label="RabbitMQ\nTopic: get_order_by_id"];
    Order_Service_Controller [label="OrderManagementController\n(Order Service)\n@MessagePattern(GET_ORDER_BY_ID)"];
    Order_Service_Service [label="OrderManagementService\n(Order Service)\nhandleGetOrderById()"];
    Database [shape=cylinder, color=grey, label="PostgreSQL\n(Orders Table)"];

    Client -> API_Gateway_Controller [label="GET /orders/:id"];
    API_Gateway_Controller -> API_Gateway_Service [label="getOrderById(id)"];
    API_Gateway_Service -> RabbitMQ [label="ClientProxy.send()"];
    RabbitMQ -> Order_Service_Controller [label="Consume Message"];
    Order_Service_Controller -> Order_Service_Service [label="handleGetOrderById()"];
    Order_Service_Service -> Database [label="Repository.findOne({id})"];
    Database -> Order_Service_Service [label="Return Order"];
    Order_Service_Service -> Order_Service_Controller [label="Return Order"];
    Order_Service_Controller -> RabbitMQ [label="Return Response"];
    RabbitMQ -> API_Gateway_Service [label="Return Response"];
    API_Gateway_Service -> API_Gateway_Controller [label="Return Data"];
    API_Gateway_Controller -> Client [label="HTTP 200 OK"];
}
