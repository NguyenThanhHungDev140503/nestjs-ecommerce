digraph GetAllOrders {
    rankdir=LR;
    node [shape=box, style=filled, color=lightblue];

    Client [shape=ellipse, color=green, label="Client"];
    API_Gateway_Controller [label="OrderManagementController\n(API Gateway)\n@Get()"];
    API_Gateway_Service [label="OrderManagementService\n(API Gateway)\ngetAllOrders()"];
    RabbitMQ [shape=diamond, color=orange, label="RabbitMQ\nTopic: get_all_orders"];
    Order_Service_Controller [label="OrderManagementController\n(Order Service)\n@MessagePattern(GET_ALL_ORDERS)"];
    Order_Service_Service [label="OrderManagementService\n(Order Service)\nhandleGetAllOrders()"];
    Database [shape=cylinder, color=grey, label="PostgreSQL\n(Orders Table)"];

    Client -> API_Gateway_Controller [label="GET /orders"];
    API_Gateway_Controller -> API_Gateway_Service [label="getAllOrders()"];
    API_Gateway_Service -> RabbitMQ [label="ClientProxy.send()"];
    RabbitMQ -> Order_Service_Controller [label="Consume Message"];
    Order_Service_Controller -> Order_Service_Service [label="handleGetAllOrders()"];
    Order_Service_Service -> Database [label="Repository.find()"];
    Database -> Order_Service_Service [label="Return Orders"];
    Order_Service_Service -> Order_Service_Controller [label="Return Orders"];
    Order_Service_Controller -> RabbitMQ [label="Return Response"];
    RabbitMQ -> API_Gateway_Service [label="Return Response"];
    API_Gateway_Service -> API_Gateway_Controller [label="Return Data"];
    API_Gateway_Controller -> Client [label="HTTP 200 OK"];
}
